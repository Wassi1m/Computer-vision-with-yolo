

# Modèle de configuration pour une VM d'entraînement GCP.
#
# Copier en `.env.gcp` (non versionné) et renseigner les valeurs réelles :
#     cp .env.gcp.exemple .env.gcp
#
# L'adresse IP externe d'une instance GCP est éphémère par défaut : elle change
# à chaque arrêt/redémarrage. La mettre à jour ici après un redémarrage, ou
# réserver une IP statique dans la console.

GCP_INSTANCE=nom-de-l-instance
GCP_ZONE=us-central1-a
GCP_PROJET=votre-projet-id
GCP_USER=votre-utilisateur
GCP_SSH_KEY=$HOME/.ssh/id_rsa

# Renseigne automatiquement par les scripts a chaque demarrage : l'IP externe
# est ephemere et change a chaque cycle arret/demarrage.
GCP_HOST=0.0.0.0

# Chemin de gcloud, necessaire pour demarrer et arreter l'instance.
GCLOUD=$HOME/google-cloud-sdk/bin/gcloud

GCP_WORKDIR=/home/votre-utilisateur/ppe

# À adapter au GPU et à la RAM de la machine.
GCP_BATCH=32
GCP_WORKERS=4

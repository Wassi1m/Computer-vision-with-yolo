venv/
.venv/
__pycache__/
*.pyc

ppe_detection/data/
surveillance_suite/data/

# Jeux de donnees deposes a la racine. Cas vu le 2026-08-13 : un telechargement
# de sortie Kaggle sans chemin explicite ecrit dans le repertoire courant, et un
# `git add -A` y embarque des milliers d'images sans qu'on le remarque.
/donnees/
/data/

# Cache Hugging Face (téléchargements de datasets, régénérable)
.cache_hf/

# Paquets Colab (zips de dataset + résultats d'entraînement bruts, régénérables
# depuis improvements/p*_merge_*.py -- les modèles finaux déployés sont dans
# ppe_detection/models/ et surveillance_suite/models/, eux versionnés)
reports/colab_package/
reports/result_colab/
reports/v2_results/runs/

# Exports ONNX (régénérables via improvements/p3_benchmark_pipeline.py)
ppe_detection/models/*.onnx

# Sauvegardes locales de poids pré-fine-tuning
ppe_detection/models/*_pre_*.pt
surveillance_suite/models/*_pre_*.pt
surveillance_suite/models/*_backup.pt

# Configuration d'accès aux machines d'entraînement : adresse, utilisateur,
# chemin de clé. Propre à chaque poste, et à ne jamais publier.
# Le modèle .env.gcp.exemple, lui, est versionné.
.env.gcp
.env

# Modèles (.pt) : gardés en local uniquement, pas dans le dépôt (142 Mo à eux
# seuls, ralentissaient le push). Le suivi de version passe par
# tests/reference_modeles.json (métriques + provenance, committé) plutôt que
# par git sur les binaires -- voir docs/registre_modeles.md.
ppe_detection/models/*.pt
surveillance_suite/models/*.pt

# Poids issus des runs d'entrainement sur la VM (reports/v3_results/<jeu>_robuste/)
# et sauvegardes des anciens poids avant installation : memes raisons que ci-dessus.
reports/v3_results/*_robuste/*.pt
reports/v3_results/poids_remplaces/

# Jeu equilibre reconstruit par improvements/p10_sous_ensemble_epi.py
ppe_detection/data/extracted/ppe_14c_equilibre/
